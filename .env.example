# All optional: every value below has a default in creator_program/config.py.

DATABASE_PATH=creator_program.db
LOG_LEVEL=INFO

# Screening thresholds. Below MIN, decline; between the two, send to a human.
MIN_FOLLOWERS=5000
REVIEW_FOLLOWERS=20000

# Cents per 1,000 views, and the floor below which a transfer costs more than
# it moves.
RATE_CENTS_PER_1K=250
MIN_PAYOUT_CENTS=100

# Retry policy.
MAX_ATTEMPTS=4
BACKOFF_BASE_SECONDS=2
# A task still running this long belongs to a dead worker and is retried.
LEASE_SECONDS=600

# The fake platform API fails this often, seeded so a run is reproducible.
# Set to 0 for a clean run; raise it to watch the dead letter queue fill.
PLATFORM_FAILURE_RATE=0.25
PLATFORM_SEED=7

# Any endpoint accepting a JSON body: Slack, Discord, an n8n webhook. Unset
# means failures still reach stderr and `dlq`.
ALERT_WEBHOOK_URL=
