# Environment for the n8n workflows.
#
# These go in Coolify, on the n8n service, NOT in this file and not in the
# workflow JSON. A workflow exported with a token inside it is a token in git
# history, and n8n exports are the single easiest way to leak one: people
# paste them into issues.
#
# Every one of these is read at execution time with $env.NAME, which means
# changing a threshold is editing a variable and restarting, rather than
# editing a workflow that is currently running.

# --- required by the Code nodes ---------------------------------------------
# The screening rules call require('crypto') to derive tracking codes. Without
# this the node throws at runtime and not at import, so the workflow looks
# perfectly healthy right up until its first execution.
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Used to build links into alerts. Set it to the public n8n URL with no
# trailing slash, or every alert links to 'undefined/workflow/...'.
N8N_EDITOR_BASE_URL=https://n8n.senaproject.online

# --- the sources -------------------------------------------------------------
APPLICATIONS_URL=https://example.invalid/applications
PLATFORM_API_URL=https://example.invalid/platform
MAILER_URL=https://example.invalid/mail/send

# --- screening thresholds ----------------------------------------------------
# Change one of these and re-run workflow 05 before and after. That is the
# entire workflow for tuning a rule: propose, measure, compare, keep or revert.
MIN_FOLLOWERS=5000
REVIEW_FOLLOWERS=20000

# --- payouts -----------------------------------------------------------------
RATE_CENTS_PER_1K=250
MIN_PAYOUT_CENTS=100
# The circuit breaker in workflow 02. A period totalling more than this many
# times the previous one is computed, stored, and held for a human instead of
# being reported as normal.
PAYOUT_SANITY_MULTIPLIER=3
PAYOUT_CEILING_CENTS=500000

# --- alerting ----------------------------------------------------------------
# Slack, Discord, or another n8n webhook. Anything accepting {"text": "..."}.
ALERT_WEBHOOK_URL=
# Below this, the morning digest marks itself as needing attention.
MIN_ACCURACY=0.8

# --- the replay endpoint -----------------------------------------------------
# Workflow 04 exposes a public webhook that re-runs work which can send email.
# A long random string, and not one that appears anywhere else.
REPLAY_TOKEN=
